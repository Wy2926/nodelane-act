---
import Layout from '../layouts/Layout.astro';
import release from '../data/releases.json';
import markets from '../data/markets.json';
interface Props {lang:'zh'|'en'}
const {lang}=Astro.props;
const zh=lang==='zh';
const href=(path:string)=>`${zh?'':'/en'}/${path}/`;
const {files,version}=release;
const title=zh?'让 AI 开始行动。':'Put your AI to work.';
const description=zh?'下载 NodeLane Act 的 MCP 和浏览器扩展。两个组件，自动连接，直接使用你的网站登录会话。':'Download the NodeLane Act MCP and browser extension. Two components, automatic connection, your existing website sessions.';
const size=(bytes:number)=>`${(bytes/1024).toFixed(0)} KB`;
const cards=[{file:files.plugin,title:zh?'MCP 插件':'MCP plugin',lead:zh?'面向 Codex 和支持 stdio 的 MCP 客户端。包含服务、插件清单、浏览器扩展与安装文档。':'For Codex and MCP clients with stdio support. Includes the server, plugin manifest, browser extension and installation guide.',button:zh?'下载 MCP · ZIP':'Download MCP · ZIP',primary:true},{file:files.extension,title:zh?'浏览器扩展':'Browser extension',lead:zh?'在你自己的 Chrome 或 Edge 中执行网站操作。解压后加载扩展，与同机 MCP 自动连接。':'Runs website actions inside your Chrome or Edge. Extract and load the extension; it connects to the MCP on the same computer.',button:zh?'下载扩展 · ZIP':'Download extension · ZIP',primary:false}];
---
<Layout title={zh?'下载':'Downloads'} description={description} lang={lang} page="download">
  <section class="wrap section" style="padding-top:65px"><div class="eyebrow"><span class="tiny-rule"></span>START HERE / v{version}</div><h1>{title}</h1><p class="hero-lead" style="max-width:800px">{description}</p>
    <div class="notice">{zh?'需要 Node.js 22+、Chrome / Edge 120+，以及支持本地 MCP 的 AI 客户端。当前版本在 Windows + Chrome 上完成验收；浏览器扩展以开发者模式加载。':'Requires Node.js 22+, Chrome / Edge 120+, and an AI client supporting local MCP. This release has been verified on Windows + Chrome. Load the browser extension in developer mode.'} <a class="text-link" href={href('docs')}>{zh?'安装步骤 →':'Installation guide →'}</a></div>
    <div class="download-grid">{cards.map(card=><article class:list={['download-card',{primary:card.primary}]}><span class="release-badge">v{version} · {size(card.file.bytes)}</span><h2>{card.title}</h2><p>{card.lead}</p><a class:list={['button',{secondary:!card.primary}]} href={card.file.url} download>{card.button}<span aria-hidden="true">↓</span></a><p class="download-meta">{card.file.name}</p><details class="checksum"><summary>SHA-256</summary><p>{card.file.sha256}</p><button class="copy-button" data-copy={card.file.sha256}>{zh?'复制校验值':'Copy checksum'}</button></details></article>)}</div>
    <div class="download-tools"><div><h3>{zh?'客户端支持 MCPB？':'Does your client support MCPB?'}</h3><p>{zh?'导入 MCPB 可安装 MCP 服务；浏览器扩展仍需单独安装。':'Import the MCPB to install the server. Install the browser extension separately.'}</p><p class="download-meta">v{version} · {size(files.mcpb.bytes)} · Node.js 22+</p></div><a class="text-link" href={files.mcpb.url} download>{zh?'下载 MCPB':'Download MCPB'} ↓</a></div>
    <p class="fineprint"><a href="/downloads/SHA256SUMS.txt">{zh?'全部 SHA-256 校验值':'All SHA-256 checksums'} ↗</a>　·　<a href="https://github.com/Wy2926/nodelane-act/releases">GitHub Releases ↗</a>　·　<a href={href('changelog')}>{zh?'更新日志':'Changelog'} →</a></p>
  </section>
  <section class="platform-section"><div class="wrap"><div class="section-heading"><div class="eyebrow"><span class="tiny-rule"></span>MCP DIRECTORY</div><h2>{zh?'从你熟悉的目录发现 Act。':'Find Act in your MCP directory.'}</h2><p>{zh?'目录状态与安装包分开更新。官网文件可直接下载，无需等待目录收录。':'Directory listings and downloads are updated separately. The files above are available directly.'}</p></div><div class="market-grid">{markets.map(market=><article class="market-card"><h3>{market.name}</h3><p class="status-label">{market.status==='published'?(zh?'已发布':'Published'):market.status==='submitted'?(zh?'已提交，等待收录':'Submitted, awaiting listing'):(zh?'准备发布':'Publication in progress')}</p><a class="text-link" href={market.url}>{market.status==='published'?(zh?'查看条目 ↗':'View listing ↗'):(zh?'访问目录 ↗':'Visit directory ↗')}</a></article>)}</div></div></section>
  <section class="wrap section"><div class="section-heading"><h2>{zh?'安装之后，就像平常一样交代任务。':'Once installed, just ask.'}</h2><p>{zh?'例如：“在 Reddit 找到讨论本地 AI 的社区，列出最近一周的热门帖子。”Act 会按需加载 Reddit 的能力，并返回精简内容和分页游标。':'For example: “Find Reddit communities about local AI and list their top posts this week.” Act loads the relevant Reddit capabilities and returns compact results with pagination cursors.'}</p></div><a class="button secondary" href={href('docs')}>{zh?'阅读使用文档':'Read the docs'} →</a></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
const {lang='zh'} = Astro.props as {lang?:'zh'|'en'};
const zh=lang==='zh'; const href=(path='')=>`${zh?'':'/en'}/${path?path+'/':''}`;
---
<Layout lang={lang} title={zh?'让 AI 直接操作你的网站':'Put your AI to work on the web'} description={zh?'通过一个 MCP 和浏览器扩展，让 AI 在你已登录的 Reddit、知乎、X 和 WhatsApp 中搜索、阅读、翻页和互动。按需提供工具，精简返回内容。':'One MCP and a browser extension. Search, read, paginate and act on Reddit, Zhihu, X and WhatsApp through your own browser, with tools loaded on demand.'}>
  <section class="hero wrap">
    <div class="hero-copy"><div class="eyebrow"><span class="tiny-rule"></span>{zh?'浏览器里的行动能力':'ACTIONS, INSIDE YOUR BROWSER'}</div><h1>{zh?<>你的网站，<br/>AI <span>直接操作。</span></>:<>Your websites.<br/><span>Your AI, in action.</span></>}</h1><p class="hero-lead">{zh?'从发现一条讨论，到整理未读消息、回复与发布。Act 把网站操作封装成按需调用的工具，使用你自己的浏览器登录状态。':'From finding a discussion to reviewing unread messages, replying and publishing. Act turns website actions into focused tools, using the session in your own browser.'}</p><div class="hero-cta"><a class="button" href={href('download')}>{zh?'下载并开始使用':'Download Act'} <span aria-hidden="true">↗</span></a><a class="text-link" href="https://github.com/Wy2926/nodelane-act">{zh?'查看源代码':'View source'} <span aria-hidden="true">↗</span></a></div><p class="hero-note">{zh?'免费开源 · 无配对码 · 无需申请网站 API Key':'Free & open source · No pairing codes · No website API key'}</p></div>
    <div class="action-demo" aria-label={zh?'按需调用示例':'On-demand tool example'}><div class="demo-top"><img class="demo-icon" src="/nodelane-logo.png" width="23" height="23" alt=""/><span>{zh?'一次指令，几个明确的动作':'One request. A few focused actions.'}</span><span class="demo-label">{zh?'示例':'EXAMPLE'}</span></div><div class="demo-request"><span class="request-label">{zh?'你的请求':'YOUR REQUEST'}</span><p id="demo-request">{zh?'找几篇关于 MCP 的讨论，读一读评论。':'Find discussions about MCP and read the comments.'}</p></div><div class="platform-switch" role="tablist" aria-label={zh?'示例网站':'Example website'}><button role="tab" aria-selected="true" aria-controls="demo-panel" id="reddit-tab" data-platform="reddit">Reddit</button><button role="tab" aria-selected="false" aria-controls="demo-panel" id="zhihu-tab" data-platform="zhihu" tabindex="-1">知乎</button><button role="tab" aria-selected="false" aria-controls="demo-panel" id="x-tab" data-platform="x" tabindex="-1">X</button><button role="tab" aria-selected="false" aria-controls="demo-panel" id="whatsapp-tab" data-platform="whatsapp" tabindex="-1">WhatsApp</button></div><div class="demo-flow" id="demo-panel" role="tabpanel" aria-labelledby="reddit-tab"><div class="flow-row"><span>01</span><div><code>site.context</code><small>{zh?'使用你的浏览器会话':'Use your browser session'}</small></div><b>→</b></div><div class="flow-row"><span>02</span><div><code>site.discover</code><small id="demo-discover">{zh?'只取 Reddit 的搜索与评论工具':'Get only Reddit search and comment tools'}</small></div><b>→</b></div><div class="flow-row"><span>03</span><div><code>site.execute</code><small>{zh?'执行操作，返回精简结果':'Run actions, return concise results'}</small></div><b>↵</b></div></div><div class="demo-result"><span class="result-glyph">≡</span><div><strong>{zh?'内容给全，上下文按需。':'The content you need. Only the context you need.'}</strong><p>{zh?'短摘录起步 · 正文再展开 · 游标继续翻页':'Short excerpts · Expand full text · Continue with cursors'}</p></div></div></div>
  </section>
  <div class="proof-strip"><div class="wrap proof-inner"><p>{zh?'一个 MCP，多个网站。':'One MCP. More websites.'}</p><div><strong>03</strong><span>{zh?'固定工具入口':'stable tool entry points'}</span></div><div><strong>137</strong><span>{zh?'已实现的网站操作':'implemented website actions'}</span></div><div><strong>MIT</strong><span>{zh?'开源许可':'open source license'}</span></div></div></div>
  <section class="section wrap"><div class="section-heading"><div class="eyebrow">01 / {zh?'能做什么':'WHAT YOU CAN DO'}</div><h2>{zh?'从发现内容，到完成操作。':'From finding something to getting it done.'}</h2><p>{zh?'围绕网站原本的使用方式，保留内容结构与分页能力。':'Built around how each website works, including content structure and pagination.'}</p></div><div class="feature-grid"><article><span class="feature-symbol">⌕</span><h3>{zh?'找到值得读的内容':'Find what is worth reading'}</h3><p>{zh?'看推荐、搜索社区和讨论，浏览社区帖子、话题内容，以及问题下的回答。':'Browse recommendations, find communities and discussions, and explore posts, topics and answers.'}</p></article><article><span class="feature-symbol">≡</span><h3>{zh?'读到需要的那一层':'Read as deep as you need'}</h3><p>{zh?'先看短摘录，再获取正文和评论。支持继续翻页，不把截断内容当作已读完。':'Start with excerpts, then retrieve full text and comments. Continue paging without mistaking truncation for completion.'}</p></article><article><span class="feature-symbol">↗</span><h3>{zh?'把下一步也做完':'Take the next step'}</h3><p>{zh?'按你的指令点赞、收藏、关注、回复、发布或发送消息。执行结果不确定时，会明确说明。':'Vote, save, follow, reply, publish or send a message when you ask. Uncertain outcomes are reported explicitly.'}</p></article></div></section>
  <section class="platform-section"><div class="wrap"><div class="section-heading inline"><div><div class="eyebrow">02 / {zh?'网站适配':'PLATFORM ADAPTERS'}</div><h2>{zh?'内容与沟通，一个入口。':'Your feeds and conversations, connected.'}</h2></div><a class="text-link" href={href('platforms')}>{zh?'查看完整支持范围':'See platform support'} ↗</a></div><div class="platform-list"><a href={href('reddit-mcp')} class="platform-row"><span class="platform-badge reddit-badge">r/</span><div><h3>Reddit</h3><p>{zh?'推荐 · 社区 · 帖子 · 评论 · 收藏与互动':'Recommendations · Communities · Posts · Comments · Actions'}</p></div><span class="operation-count">26 <small>{zh?'操作':'actions'}</small></span><span aria-hidden="true">↗</span></a><a href={href('zhihu-mcp')} class="platform-row"><span class="platform-badge zhihu-badge">知</span><div><h3>知乎 <small>Zhihu</small></h3><p>{zh?'推荐 · 话题 · 问题与回答 · 评论 · 收藏与互动':'Feeds · Topics · Questions & answers · Comments · Actions'}</p></div><span class="operation-count">28 <small>{zh?'操作':'actions'}</small></span><span aria-hidden="true">↗</span></a><a href={href('x-mcp')} class="platform-row"><span class="platform-badge x-badge">X</span><div><h3>X <small>Twitter</small></h3><p>{zh?'推荐 · 搜索 · 趋势 · 通知 · 聊天与发布':'Feeds · Search · Trends · Notifications · Chat & publishing'}</p></div><span class="operation-count">37 <small>{zh?'操作':'actions'}</small></span><span aria-hidden="true">↗</span></a><a href={href('whatsapp-mcp')} class="platform-row"><span class="platform-badge whatsapp-badge">W</span><div><h3>WhatsApp</h3><p>{zh?'会话 · 消息 · 联系人 · 群组 · 频道与动态':'Chats · Messages · Contacts · Groups · Channels & Status'}</p></div><span class="operation-count">46 <small>{zh?'操作':'actions'}</small></span><span aria-hidden="true">↗</span></a></div><p class="fineprint">{zh?'各站点页面列出具体能力与限制。先获取概览，再按需展开内容或执行互动。':'Each platform page lists its capabilities and limits. Start with an overview, then expand content or take action.'}</p></div></section>
  <section class="section wrap architecture"><div><div class="eyebrow">03 / {zh?'更少上下文':'LESS CONTEXT'}</div><h2>{zh?<>网站可以增加，<br/>工具入口保持简洁。</>:<>More websites.<br/>The same small tool surface.</>}</h2><p>{zh?'AI 先选择网站，再读取对应操作的参数。新增适配包，不需要把所有网站的工具定义都塞进上下文。':'Your AI selects a website, then loads the relevant action schemas. Adding an adapter does not fill the context with every website’s tools.'}</p><a class="text-link" href={href('docs')}>{zh?'了解调用方式':'Explore the tool flow'} ↗</a></div><div class="code-surface"><div><span>TOOLS / ON DEMAND</span><span>03</span></div><pre><code is:raw>site.context({ site: "zhihu" })

site.discover({
  site: "zhihu",
  operation: "answers"
})

site.execute({
  targetId: "…",
  operation: "answers",
  args: { questionId: "…", limit: 5 }
})</code></pre></div></section>
  <section class="closing"><div class="wrap"><div><div class="eyebrow">{zh?'让下一次浏览，直接进入行动。':'LET YOUR NEXT BROWSE BECOME AN ACTION.'}</div><h2>{zh?'装好 Act，告诉 AI 你想做什么。':'Install Act. Tell your AI what to do.'}</h2><p>{zh?'安装本地 MCP 与浏览器扩展，即可自动连接。':'Install the local MCP and companion extension. They connect automatically.'}</p></div><a class="button white" href={href('download')}>{zh?'获取 NodeLane Act':'Get NodeLane Act'} ↗</a></div></section>
  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-platform]'));
    const choose = (tab:HTMLButtonElement) => {
      tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});
      document.getElementById('demo-panel')?.setAttribute('aria-labelledby',tab.id);
      const zh=document.documentElement.lang!=='en';
      const examples:Record<string,{zh:[string,string];en:[string,string]}>= {
        reddit:{zh:['找几篇关于 MCP 的讨论，读一读评论。','只取 Reddit 的搜索与评论工具'],en:['Find discussions about MCP and read the comments.','Get only Reddit search and comment tools']},
        zhihu:{zh:['查看这个知乎问题，比较前几个回答。','只取知乎的问题、回答与评论工具'],en:['Read this Zhihu question and compare a few answers.','Get only Zhihu question, answer and comment tools']},
        x:{zh:['看看 X 推荐，有多少通知和聊天未读？','只取 X 首页概览与详情工具'],en:['Review my X feed and unread notification and chat counts.','Get only X home overview and detail tools']},
        whatsapp:{zh:['整理 WhatsApp 未读会话，找出需要回复的消息。','只取 WhatsApp 会话与消息工具'],en:['Review unread WhatsApp chats and find messages needing a reply.','Get only WhatsApp chat and message tools']}
      };
      const [request,discovery]=examples[tab.dataset.platform||'reddit'][zh?'zh':'en'];
      const text=document.getElementById('demo-discover');if(text)text.textContent=discovery;
      const prompt=document.getElementById('demo-request');if(prompt)prompt.textContent=request;
    };
    tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>choose(tab));tab.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const next=tabs[e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length];choose(next);next.focus();}});});
  </script>
</Layout>
